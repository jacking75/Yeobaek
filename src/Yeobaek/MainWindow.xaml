<Window x:Class="Yeobaek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Yeobaek.Ui"
        Title="{ui:Localize App.Name}" Width="1280" Height="860" MinWidth="560" MinHeight="400"
        Icon="Assets/yeobaek.ico"
        FontFamily="{StaticResource UiFont}"
        Background="{StaticResource ChromeBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

  <Window.Resources>
    <!-- EventSetter 가 이 창의 처리기를 가리키므로 창 리소스에 둔다 -->
    <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
      <EventSetter Event="MouseUp" Handler="TabItem_MouseUp" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ToolTip" Value="{Binding DisplayUrl}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8,8,0,0" Height="34" Margin="0,0,2,0" Padding="12,0,5,0">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 탭 줄 -->
    <DockPanel x:Name="TabStripRow" Grid.Row="0" Margin="8,6,8,0">
      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;"
              ToolTip="{ui:Localize Main.NewTabTip}" AutomationProperties.Name="{ui:Localize Main.NewTab}" Margin="4,0,0,2" Click="NewTab_Click" />
      <ListBox x:Name="TabStrip" Background="Transparent" BorderThickness="0" Padding="0"
               ItemContainerStyle="{StaticResource TabItemStyle}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Disabled"
               SelectionChanged="TabStrip_SelectionChanged">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <ui:TabStripPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{StaticResource TextBrush}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Button Grid.Column="1" Style="{StaticResource TabCloseButton}" Margin="4,0,0,0"
                      ToolTip="{ui:Localize Main.CloseTabTip}" AutomationProperties.Name="{ui:Localize Main.CloseTab}" Click="CloseTab_Click" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- 도구 모음 -->
    <Border x:Name="ToolbarRow" Grid.Row="1" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="6,5">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;"
                  ToolTip="{ui:Localize Main.BackTip}" AutomationProperties.Name="{ui:Localize Main.Back}" Click="Back_Click" />
          <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;"
                  ToolTip="{ui:Localize Main.ForwardTip}" AutomationProperties.Name="{ui:Localize Main.Forward}" Click="Forward_Click" />
          <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                  ToolTip="{ui:Localize Main.ReloadTip}" AutomationProperties.Name="{ui:Localize Main.Reload}" Click="Reload_Click" Margin="0,0,6,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
          <Button x:Name="ShieldButton" Style="{StaticResource PillButton}" AutomationProperties.Name="{ui:Localize Main.ShieldName}" Margin="0,0,6,0" Click="ToggleAllowlist_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA18;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock x:Name="ShieldText" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <ToggleButton x:Name="ReaderButton" Style="{StaticResource IconToggleButton}" Content="&#xE736;"
                        ToolTip="{ui:Localize Main.ReaderTip}" AutomationProperties.Name="{ui:Localize Main.ReaderName}" Click="Reader_Click" />
          <Button Style="{StaticResource IconButton}" Content="&#xE7BC;" ToolTip="{ui:Localize Main.QueueName}" AutomationProperties.Name="{ui:Localize Main.QueueName}" Click="ShowQueue_Click" />
          <Button Style="{StaticResource IconButton}" Content="&#xE8F1;" ToolTip="{ui:Localize Main.ArchiveTip}" AutomationProperties.Name="{ui:Localize Main.ArchiveName}" Click="ShowArchive_Click" />
          <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="{ui:Localize Main.Menu}" AutomationProperties.Name="{ui:Localize Main.Menu}" Click="Menu_Click">
            <Button.ContextMenu>
              <ContextMenu x:Name="AppMenu" Placement="Bottom" Opened="AppMenu_Opened">
                <MenuItem Header="{ui:Localize Main.NewTab}" InputGestureText="Ctrl+T" Click="NewTab_Click" />
                <MenuItem Header="{ui:Localize Main.NewWindow}" InputGestureText="Ctrl+N" Click="NewWindow_Click" />
                <MenuItem Header="{ui:Localize Main.ReopenTab}" InputGestureText="Ctrl+Shift+T" Click="ReopenTab_Click" />
                <Separator />
                <MenuItem Header="{ui:Localize Main.ReaderToggle}" InputGestureText="Ctrl+R" Click="Reader_Click" />
                <MenuItem Header="{ui:Localize Main.AddToQueue}" InputGestureText="Ctrl+D" Click="AddToQueue_Click" />
                <MenuItem Header="{ui:Localize Main.QueueName}" Click="ShowQueue_Click" />
                <MenuItem Header="{ui:Localize Main.ArchiveArticle}" InputGestureText="Ctrl+S" Click="Archive_Click" />
                <MenuItem Header="{ui:Localize Main.ArchiveSearch}" InputGestureText="Ctrl+Shift+F" Click="ShowArchive_Click" />
                <Separator />
                <MenuItem Header="{ui:Localize Main.PickAd}" InputGestureText="Alt+Shift+Z" Click="Pick_Click" />
                <MenuItem Header="{ui:Localize Main.ManageRules}" Click="ManageRules_Click" />
                <MenuItem x:Name="AllowlistMenuItem" Header="{ui:Localize Main.Allowlist}" InputGestureText="Alt+Shift+A"
                          IsCheckable="True" Click="ToggleAllowlist_Click" />
                <Separator />
                <MenuItem Header="{ui:Localize Main.EditBlockList}" Click="EditBlockList_Click" />
                <MenuItem Header="{ui:Localize Main.EditSettings}" Click="EditSettings_Click" />
                <MenuItem Header="{ui:Localize Main.OpenDataFolder}" Click="OpenDataFolder_Click" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>

        <TextBox x:Name="AddressBar" Style="{StaticResource AddressBarTextBox}" AutomationProperties.Name="{ui:Localize Main.AddressName}" Tag="{ui:Localize Main.AddressPlaceholder}"
                 KeyDown="AddressBar_KeyDown"
                 TextChanged="AddressBar_TextChanged"
                 PreviewMouseLeftButtonDown="AddressBar_PreviewMouseLeftButtonDown"
                 GotKeyboardFocus="AddressBar_GotKeyboardFocus"
                 LostKeyboardFocus="AddressBar_LostKeyboardFocus" />
      </DockPanel>
    </Border>

    <ProgressBar x:Name="LoadingBar" Grid.Row="2" IsIndeterminate="True" Visibility="Hidden"
                 BorderThickness="0" Background="Transparent" Foreground="{StaticResource AccentBrush}" />

    <!-- 탭 내용. 모든 탭의 WebView2 가 여기에 겹쳐 올라가고 활성 탭만 보인다 -->
    <Grid x:Name="TabHost" Grid.Row="3" Background="{StaticResource SurfaceBrush}">
      <Border x:Name="NewTabPanel" Background="{StaticResource SurfaceBrush}" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
          <TextBlock Text="{ui:Localize App.Name}" FontSize="44" FontWeight="Light" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="{ui:Localize Main.StartHint}" Margin="0,6,0,24" FontSize="14"
                     Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,28">
            <Button x:Name="NewTabQueueButton" Style="{StaticResource TextButton}" Click="ShowQueue_Click" />
            <Button x:Name="NewTabArchiveButton" Style="{StaticResource TextButton}" Click="ShowArchive_Click" Margin="8,0,0,0" />
          </StackPanel>
          <Grid HorizontalAlignment="Center" TextElement.FontSize="12.5" TextElement.Foreground="{StaticResource MutedTextBrush}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Ctrl+L" Margin="0,2,18,2" FontWeight="SemiBold" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{ui:Localize Main.GoToAddress}" Margin="0,2" />
            <TextBlock Grid.Row="1" Text="Ctrl+R" Margin="0,2,18,2" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{ui:Localize Main.ReaderToggle}" Margin="0,2" />
            <TextBlock Grid.Row="2" Text="Alt+Shift+Z" Margin="0,2,18,2" FontWeight="SemiBold" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{ui:Localize Main.HideRemainingAds}" Margin="0,2" />
            <TextBlock Grid.Row="3" Text="Ctrl+D" Margin="0,2,18,2" FontWeight="SemiBold" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{ui:Localize Main.AddToQueue}" Margin="0,2" />
            <TextBlock Grid.Row="4" Text="{ui:Localize Main.ClickShortcut}" Margin="0,2,18,2" FontWeight="SemiBold" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{ui:Localize Main.BackgroundLink}" Margin="0,2" />
            <TextBlock Grid.Row="5" Text="Ctrl+Shift+T" Margin="0,2,18,2" FontWeight="SemiBold" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{ui:Localize Main.ReopenTab}" Margin="0,2" />
            <TextBlock Grid.Row="6" Text="Ctrl+S · Ctrl+Shift+F" Margin="0,2,18,2" FontWeight="SemiBold" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{ui:Localize Main.ArchiveShortcuts}" Margin="0,2" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 알림 줄. WebView2 는 WPF 요소 위에 그려지므로(에어스페이스) 내용 영역 밖에 둔다 -->
    <Border x:Name="NoticeBar" Grid.Row="4" Visibility="Collapsed" Background="{StaticResource NoticeBrush}"
            Padding="14,6,8,6" MouseEnter="NoticeBar_MouseEnter" MouseLeave="NoticeBar_MouseLeave">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource NoticeCloseButton}" ToolTip="{ui:Localize Common.Close}" AutomationProperties.Name="{ui:Localize Main.NoticeClose}" Click="NoticeClose_Click" />
        <Button x:Name="NoticeActionButton" DockPanel.Dock="Right" Style="{StaticResource NoticeActionButton}"
                Margin="8,0,6,0" Click="NoticeAction_Click" />
        <TextBlock x:Name="NoticeText" Foreground="White" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
