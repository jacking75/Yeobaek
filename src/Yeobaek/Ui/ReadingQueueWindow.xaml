<Window x:Class="Yeobaek.Ui.ReadingQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="나중에 읽기 - 여백" Width="820" Height="560" MinWidth="520" MinHeight="360"
        Icon="../Assets/yeobaek.ico"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <CheckBox x:Name="UnreadOnlyCheck" DockPanel.Dock="Right" Content="읽지 않은 글만" IsChecked="True"
                VerticalAlignment="Center" Click="UnreadOnlyCheck_Click" />
      <TextBlock Text="나중에 읽기" FontSize="18" FontWeight="SemiBold" />
    </DockPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource PrimaryButton}" Content="열기" Click="Open_Click" />
        <Button Style="{StaticResource TextButton}" Content="읽음 / 안 읽음" Margin="8,0,0,0" Click="ToggleRead_Click" />
        <Button Style="{StaticResource TextButton}" Content="삭제" Margin="8,0,0,0" Click="Delete_Click" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                 Text="두 번 누르면 새 탭에서 열고 읽음으로 표시합니다." />
    </DockPanel>

    <Grid>
      <ListView x:Name="QueueList" Style="{StaticResource PlainListView}" SelectionMode="Extended"
                MouseDoubleClick="QueueList_MouseDoubleClick" KeyDown="QueueList_KeyDown">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="ToolTip" Value="{Binding Url}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsRead}" Value="True">
                <Setter Property="Opacity" Value="0.5" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.View>
          <GridView>
            <GridViewColumn Header="제목" Width="440" DisplayMemberBinding="{Binding DisplayTitle}" />
            <GridViewColumn Header="사이트" Width="170" DisplayMemberBinding="{Binding Site}" />
            <GridViewColumn Header="담은 날" Width="110" DisplayMemberBinding="{Binding AddedAt, StringFormat=yyyy-MM-dd}" />
          </GridView>
        </ListView.View>
      </ListView>
      <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400" Foreground="{StaticResource MutedTextBrush}"
                 Text="나중에 읽을 글이 없습니다. 링크를 우클릭해 '나중에 읽기에 추가'를 고르거나, 읽던 페이지에서 Ctrl+D 를 누르세요." />
    </Grid>
  </DockPanel>
</Window>
