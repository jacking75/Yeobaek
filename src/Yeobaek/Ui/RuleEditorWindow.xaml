<Window x:Class="Yeobaek.Ui.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Yeobaek.Ui"
        Title="{ui:Localize Rules.WindowTitle}" Width="760" Height="560" MinWidth="520" MinHeight="380"
        Icon="../Assets/yeobaek.ico"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="20">

    <!-- 사이트 고르기 -->
    <DockPanel DockPanel.Dock="Top">
      <TextBlock Text="{ui:Localize Common.Site}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="{ui:Localize Rules.Load}" Margin="8,0,0,0" Click="LoadHost_Click" />
      <TextBox x:Name="HostBox" Style="{StaticResource FieldTextBox}" Tag="{ui:Localize Rules.HostExample}" KeyDown="HostBox_KeyDown" />
    </DockPanel>

    <CheckBox x:Name="AllowlistCheck" DockPanel.Dock="Top" Margin="0,14,0,0" VerticalContentAlignment="Center"
              Content="{ui:Localize Rules.Allowlist}" Click="AllowlistCheck_Click" />

    <TextBlock DockPanel.Dock="Top" Text="{ui:Localize Rules.Applied}" FontWeight="SemiBold" Margin="0,20,0,8" />

    <!-- 규칙 추가 -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{ui:Localize Rules.Add}" Margin="8,0,0,0" Click="AddRule_Click" />
      <CheckBox x:Name="GlobalCheck" DockPanel.Dock="Right" Content="{ui:Localize Rules.Global}" VerticalAlignment="Center" Margin="10,0,0,0" />
      <TextBox x:Name="SelectorBox" Style="{StaticResource FieldTextBox}" Tag="{ui:Localize Rules.SelectorHint}"
               FontFamily="Consolas, Malgun Gothic" KeyDown="SelectorBox_KeyDown" />
    </DockPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="{ui:Localize Rules.DeleteSelected}" Click="DeleteRules_Click" />
      <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                 Text="{ui:Localize Rules.ReloadHint}" />
    </DockPanel>

    <Grid>
      <ListView x:Name="RuleList" Style="{StaticResource PlainListView}" SelectionMode="Extended" KeyDown="RuleList_KeyDown">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="{ui:Localize Rules.Scope}" Width="170" DisplayMemberBinding="{Binding ScopeLabel}" />
            <GridViewColumn Header="{ui:Localize Rules.Selector}" Width="400" DisplayMemberBinding="{Binding Selector}" />
            <GridViewColumn Header="{ui:Localize Rules.AddedAt}" Width="110" DisplayMemberBinding="{Binding AddedAt, StringFormat=yyyy-MM-dd}" />
          </GridView>
        </ListView.View>
      </ListView>
      <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" Foreground="{StaticResource MutedTextBrush}"
                 Text="{ui:Localize Rules.Empty}" />
    </Grid>
  </DockPanel>
</Window>
