<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Yeobaek</RootNamespace>
    <AssemblyName>Yeobaek</AssemblyName>
    <ApplicationIcon>Assets\yeobaek.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>여백</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- 버전을 고정해 빌드를 재현 가능하게 한다. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SmartReader" Version="0.11.1" />
    <!-- 보관할 때 본문 HTML 의 이미지 주소를 바꾸는 데 직접 쓴다. SmartReader 가 쓰는 버전과 맞춘다. -->
    <PackageReference Include="AngleSharp" Version="1.5.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 문서 생성 전 주입 스크립트. DocumentScriptInjector 가 GetManifestResourceStream 으로 읽는다 -->
    <EmbeddedResource Include="Assets\*.js" LogicalName="Yeobaek.Assets.%(Filename)%(Extension)" />
    <Resource Include="Assets\yeobaek.ico" />
  </ItemGroup>

</Project>
